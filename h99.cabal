cabal-version:       3.16
name:                h99
version:             0.1.0
synopsis:            Answers for H-99.
description:
  Answers for H-99: Ninety-Nine Haskell Problems, tested with doctest.
homepage:            https://github.com/cohei/h99
license:             BSD-3-Clause
license-file:        LICENSE
author:              TANIGUCHI Kohei
maintainer:          a.d.xvii.kal.mai@gmail.com
copyright:           2016 TANIGUCHI Kohei
extra-doc-files:     README.md
build-type:          Custom

custom-setup
  setup-depends:
    base < 5,
    cabal-doctest >= 1.0.13 && < 1.1

source-repository head
  type:     git
  location: https://github.com/cohei/h99

common common
  build-depends:       base >= 4.7 && < 5
  default-language:    GHC2024

library
  import:              common
  exposed-modules:
    H99
    H99.Encoded
    H99.Problem1
    H99.Problem2
    H99.Problem3
    H99.Problem4
    H99.Problem5
    H99.Problem6
    H99.Problem7
    H99.Problem8
    H99.Problem9
    H99.Problem10
    H99.Problem11
    H99.Problem12
    H99.Problem13
    H99.Problem14
    H99.Problem15
    H99.Problem16
    H99.Problem17
    H99.Problem18
    H99.Problem19
    H99.Problem20
    H99.Problem21
    H99.Problem22
    H99.Problem23
    H99.Problem24
    H99.Problem25
    H99.Problem26
    H99.Problem27
    H99.Problem28
    H99.Problem31
    H99.Problem32
    H99.Problem33
    H99.Problem34
    H99.Problem35
    H99.Sampling
  build-depends:       random
  ghc-options:
    -Wall
    -Wcompat
    -Wcpp-undef
    -Widentities
    -Wimplicit-lift
    -Wmissing-deriving-strategies
    -Wmissing-export-lists
    -Wmissing-exported-signatures
    -Wmissing-home-modules
    -Wmissing-import-lists
    -Wmissing-kind-signatures
    -Wmissing-local-signatures
    -Wmonomorphism-restriction
    -Wpartial-fields
    -Wredundant-constraints
    -Wsafe
    -Wunticked-promoted-constructors
    -Wunused-packages
    -Wunused-type-patterns
    -fdefer-typed-holes

test-suite doctest
  import:              common
  main-is:             doctest.hs
  build-depends:       doctest
  -- cabal-doctest passes default-extensions to doctest as -X flags, but not default-language
  -- --no-magic stops doctest from expanding the module name H99 into the files under the H99 directory
  x-doctest-options:   --no-magic -XGHC2024
